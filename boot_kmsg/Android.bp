cc_binary {
    name: "boot_kmsg",
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-D_GNU_SOURCE",
    ],
    srcs: ["src/main.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
}
