cc_binary {
    name: "boot_kmsg",
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-D_GNU_SOURCE",
    ],
    srcs: [
        "src/fsutil.c",
        "src/logcat_proc.c",
        "src/main.c",
        "src/phase.c",
        "src/rotating_file.c",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
}
