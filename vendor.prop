# Bluetooth
bluetooth.device.class_of_device=90,2,12
bluetooth.hci.erroneous_data_reporting.enabled=false
bluetooth.profile.a2dp.source.enabled?=true
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.avrcp.target.enabled?=true
bluetooth.profile.bas.client.enabled?=true
bluetooth.profile.gatt.enabled?=true
bluetooth.profile.hfp.ag.enabled?=true
bluetooth.profile.hid.device.enabled?=true
bluetooth.profile.hid.host.enabled?=true
bluetooth.profile.map.server.enabled?=true
bluetooth.profile.opp.enabled?=true
bluetooth.profile.pan.nap.enabled?=true
bluetooth.profile.pan.panu.enabled?=true
bluetooth.profile.pbap.server.enabled?=true
bluetooth.profile.sap.server.enabled?=true
vendor.bluetooth.ldac.abr=true

# Camera
camera.disable_zsl_mode=0
persist.vendor.camera.HAL3.enabled=1
persist.camera.HAL3.enabled=1
persist.vendor.camera.raw.enable=1
vendor.camera.hal3.raw.support=1
ro.vendor.camera.raw.support=1
vendor.debug.camera.app.process.raw=1
vendor.debug.feature.forceEnableIMGO=1
vendor.debug.camera.Jpeg.YUV420.support=1
persist.vendor.camera.enable.default.zsl=1
vendor.debug.camera.capture.enable.boost=1
vendor.camera.mdp.cz.enable=1
vendor.camera.mdp.dre.enable=1
vendor.camera.mdp.hfg.enable=1
vendor.camera.mdp.pq.enable=1
vendor.debug.camera.3dnr.enable=1
vendor.debug.3dnr.sl2e.enable=1
vendor.mediatek.hdr.ltm=1
vendor.camprovider.enable_hidden=1

# Display
debug.sf.enable_gl_backpressure=false
debug.sf.latch_unsignaled=0
debug.sf.auto_latch_unsignaled=1
vendor.debug.sf.latch_unsignaled=0
debug.sf.treat_170m_as_sRGB=1
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=0
debug.sf.enable_egl_image_tracker=0
debug.sf.enable_hwc_vds=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.use_phase_offsets_as_durations=1
debug.sf.phase_offset_threshold_for_next_vsync_ns=6100000
debug.sf.late.sf.duration=10500000
debug.sf.late.app.duration=16600000
debug.sf.early.sf.duration=13500000
debug.sf.early.app.duration=16600000
debug.sf.earlyGl.sf.duration=13500000
debug.sf.earlyGl.app.duration=16600000
debug.sf.hwc.min.duration=1500000
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=30
ro.hwui.render_ahead=2
ro.hardware.egl=meow
ro.opengles.version=196610
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
vendor.powerhal.disp.idle_support=false

# Audio
audio.deep_buffer.media=true
audio.adm.buffering.ms=3
audio_hal.period_multiplier=2
ro.vendor.mtk_besloudness_support=1
ro.vendor.mtk_hifiaudio_support=1
persist.vendor.audiohal.aurisys.pcm_dump_on=0
persist.vendor.audiohal.p2w_dump_on=0
persist.vendor.audiohal.pcm_mixer_dump_on=0

# Media
debug.stagefright.ccodec=4
media.stagefright.thumbnail.prefer_hw_codecs=true

# Storage (use FUSE + lowerfs project quotas/casefold instead of legacy sdcardfs)
ro.sys.sdcardfs=false
external_storage.sdcardfs.enabled=0
external_storage.projid.enabled=1
external_storage.casefold.enabled=1

# Dolby Atmos
ro.vendor.dolby.dax.version=DAX3_3.7.0.8_r1
ro.vendor.audio.dolby.dax.support=true
ro.vendor.audio.dolby.surround.enable=true
vendor.audio.dolby.ds2.enabled=false
vendor.audio.dolby.ds2.hardbypass=false

# DRM
drm.service.enabled=true

# Radio
persist.radio.multisim.config=dsds
persist.vendor.radio.fd.counter=150
persist.vendor.radio.fd.off.counter=50
persist.vendor.radio.fd.off.r8.counter=50
persist.vendor.radio.fd.r8.counter=150
persist.vendor.radio.msimmode=dsds
persist.vendor.radio.mtk_dsbp_support=1
persist.vendor.radio.mtk_ps2_rat=L/W/G
persist.vendor.radio.mtk_ps3_rat=G
persist.vendor.radio.smart.data.switch=1
ro.telephony.default_network=9,9,9,9
ro.telephony.iwlan_operation_mode=default
ro.telephony.sim.count=2
telephony.active_modems.max_count=2

# Wi-Fi
wifi.concurrent.interface=ap0

