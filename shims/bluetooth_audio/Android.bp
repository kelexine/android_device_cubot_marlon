cc_library_shared {
    name: "android.hardware.bluetooth.audio-impl-mediatek",
    srcs: ["bt_audio_impl_mtk.cpp"],
    header_libs: [
        "libhardware_headers",
        "libsystem_headers",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.bluetooth.audio@2.0",
        "vendor.mediatek.hardware.bluetooth.audio@2.1",
        "libbluetooth_audio_session",
    ],
    vendor: true,
}
