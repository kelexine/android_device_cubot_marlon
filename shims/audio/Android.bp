cc_library_shared {
    name: "libshim_audio",
    srcs: ["libshim_audio.cpp"],
    header_libs: [
        "libhardware_headers",
        "libsystem_headers",
    ],
    shared_libs: [
        "libaudioutils",
    ],
    vendor: true,
}
