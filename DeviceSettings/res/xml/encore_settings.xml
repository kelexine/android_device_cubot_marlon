<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/encore_telemetry_category">
        <Preference
            android:key="encore_telemetry_stats"
            android:layout="@layout/card_telemetry_dashboard"
            android:selectable="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/encore_profile_category">
        <ListPreference
            android:key="encore_profile"
            android:icon="@drawable/ic_performance_speed"
            android:title="@string/encore_profile_title"
            android:summary="%s"
            android:entries="@array/encore_profile_entries"
            android:entryValues="@array/encore_profile_values"
            android:defaultValue="0" />

        <SwitchPreferenceCompat
            android:key="encore_gaming_mode"
            android:icon="@drawable/ic_touch_boost"
            android:title="@string/encore_gaming_mode_title"
            android:summary="@string/encore_gaming_mode_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/encore_hardware_category">
        <SwitchPreferenceCompat
            android:key="encore_touch_boost"
            android:icon="@drawable/ic_touch_boost"
            android:title="@string/encore_touch_boost_title"
            android:summary="@string/encore_touch_boost_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="encore_thermal_mitigation"
            android:icon="@drawable/ic_thermal_temp"
            android:title="@string/encore_thermal_title"
            android:summary="@string/encore_thermal_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

</PreferenceScreen>
