        <SwitchPreferenceCompat android:key="gesture_letter_o" android:title="@string/gesture_letter_o_title" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:key="marlon_gesture_letter_o_action" android:title="@string/gesture_action_title" android:entries="@array/gesture_action_entries" android:entryValues="@array/gesture_action_values" android:defaultValue="NONE" app:iconSpaceReserved="false" android:dependency="gesture_letter_o" />

        <SwitchPreferenceCompat android:key="gesture_letter_s" android:title="@string/gesture_letter_s_title" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:key="marlon_gesture_letter_s_action" android:title="@string/gesture_action_title" android:entries="@array/gesture_action_entries" android:entryValues="@array/gesture_action_values" android:defaultValue="NONE" app:iconSpaceReserved="false" android:dependency="gesture_letter_s" />

        <SwitchPreferenceCompat android:key="gesture_letter_v" android:title="@string/gesture_letter_v_title" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:key="marlon_gesture_letter_v_action" android:title="@string/gesture_action_title" android:entries="@array/gesture_action_entries" android:entryValues="@array/gesture_action_values" android:defaultValue="NONE" app:iconSpaceReserved="false" android:dependency="gesture_letter_v" />

        <SwitchPreferenceCompat android:key="gesture_letter_w" android:title="@string/gesture_letter_w_title" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:key="marlon_gesture_letter_w_action" android:title="@string/gesture_action_title" android:entries="@array/gesture_action_entries" android:entryValues="@array/gesture_action_values" android:defaultValue="NONE" app:iconSpaceReserved="false" android:dependency="gesture_letter_w" />

        <SwitchPreferenceCompat android:key="gesture_letter_z" android:title="@string/gesture_letter_z_title" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:key="marlon_gesture_letter_z_action" android:title="@string/gesture_action_title" android:entries="@array/gesture_action_entries" android:entryValues="@array/gesture_action_values" android:defaultValue="NONE" app:iconSpaceReserved="false" android:dependency="gesture_letter_z" />

        <SwitchPreferenceCompat android:key="gesture_letter_f" android:title="@string/gesture_letter_f_title" android:defaultValue="false" app:iconSpaceReserved="false" />
        <ListPreference android:key="marlon_gesture_letter_f_action" android:title="@string/gesture_action_title" android:entries="@array/gesture_action_entries" android:entryValues="@array/gesture_action_values" android:defaultValue="NONE" app:iconSpaceReserved="false" android:dependency="gesture_letter_f" />

    </PreferenceCategory>

</PreferenceScreen>
