android_app {
    name: "DeviceSettings",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,
    static_libs: [
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
        "vendor.cubot.hardware.encore-V2-java",
    ],
    optimize: {
        enabled: false,
    },
}

filegroup {
    name: "marlon_gesture_utils_srcs",
    srcs: [
        "src/org/lineageos/settings/device/gestures/ActionUtils.java",
        "src/org/lineageos/settings/device/gestures/GestureAction.java",
        "src/org/lineageos/settings/device/gestures/GestureInfo.java",
        "src/org/lineageos/settings/device/gestures/GestureNodeController.java",
        "src/org/lineageos/settings/device/gestures/GestureRegistry.java",
        "src/org/lineageos/settings/device/utils/FileUtils.java",
    ],
}
