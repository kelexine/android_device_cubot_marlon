// Authored for device/cubot/marlon.
// Author: kelexine (https://github.com/kelexine)
//
// Device-side test target -- run with:
//   atest DeviceSettingsTests
// (requires a connected device/emulator; android.util.Log calls in
// FileUtils are real Android runtime calls, not stubs, so this must run
// as an instrumented test, not a bare host-side JVM test.)
android_test {
    name: "DeviceSettingsTests",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    static_libs: [
        "androidx.test.rules",
        "androidx.test.runner",
        "junit",
    ],
    libs: [
        "android.test.base",
    ],
    instrumentation_for: "DeviceSettings",
    test_suites: ["device-tests"],
}
