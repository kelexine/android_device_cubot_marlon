# Allow Health AIDL HAL and offline charger to read battery, power_supply, and eMMC block sysfs nodes
r_dir_file(hal_health_default, sysfs_batteryinfo)
r_dir_file(hal_health_default, sysfs_power_supply)
r_dir_file(hal_health_default, sysfs_devices_block)
r_dir_file(hal_health_default, sysfs_mmcblk)
allow hal_health_default sysfs:file r_file_perms;
allow hal_health_default sysfs:lnk_file r_file_perms;

r_dir_file(charger_vendor, sysfs_batteryinfo)
r_dir_file(charger_vendor, sysfs_power_supply)
