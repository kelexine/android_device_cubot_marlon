#
# File: encore.te
# Author: kelexine <https://github.com/kelexine>
# Date: 2026-10-07
# Purpose: SELinux policy for Encore native hardware performance daemon.
#

type vendor_encore, domain;
type vendor_encore_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_encore)

# Binder IPC
binder_use(vendor_encore)
binder_call(vendor_encore, system_app)
binder_call(vendor_encore, platform_app)
binder_call(vendor_encore, system_server)
add_service(vendor_encore, hal_encore_service)

# Allow client domains to find and communicate with vendor_encore
allow { system_app platform_app system_server } hal_encore_service:service_manager find;
binder_call({ system_app platform_app system_server }, vendor_encore)

# MTK PPM control
allow vendor_encore proc_ppm:dir r_dir_perms;
allow vendor_encore proc_ppm:file rw_file_perms;

# FPSGO control
allow vendor_encore sysfs_fpsgo:dir r_dir_perms;
allow vendor_encore sysfs_fpsgo:file rw_file_perms;

# DVFSRC / Devfreq control
allow vendor_encore sysfs_devfreq:dir r_dir_perms;
allow vendor_encore sysfs_devfreq:file rw_file_perms;

# GED / GPU tuning
allow vendor_encore sysfs_ged_tuning:dir r_dir_perms;
allow vendor_encore sysfs_ged_tuning:file rw_file_perms;

# Touchpanel Game Mode
allow vendor_encore sysfs_touchpanel:dir r_dir_perms;
allow vendor_encore sysfs_touchpanel:file rw_file_perms;

# Thermal zone reading
allow vendor_encore sysfs_thermal:dir r_dir_perms;
allow vendor_encore sysfs_thermal:file r_file_perms;

# CPU scaling frequencies
allow vendor_encore sysfs_devices_system_cpu:file r_file_perms;

# Logging
allow vendor_encore kmsg_device:chr_file rw_file_perms;
