# FPS info node access for SystemUI
allow platform_app sysfs_fps:dir search;
allow platform_app sysfs_fps:file r_file_perms;

# Touchpanel / gesture node access for DeviceSettings
allow platform_app sysfs_touchpanel:dir r_dir_perms;
allow platform_app sysfs_touchpanel:file rw_file_perms;

# Custom kernel control surface access for DeviceSettings
allow platform_app sysfs_cpuidle:dir r_dir_perms;
allow platform_app sysfs_cpuidle:file rw_file_perms;

allow platform_app sysfs_scheduler:file rw_file_perms;

allow platform_app proc_tcp_cc:file rw_file_perms;

allow platform_app proc_compaction:file rw_file_perms;

allow platform_app sysfs_ged_tuning:file rw_file_perms;
