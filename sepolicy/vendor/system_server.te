# Touchpanel / gesture node read access for KeyHandler in system_server
allow system_server sysfs_touchpanel:dir r_dir_perms;
allow system_server sysfs_touchpanel:file r_file_perms;

# Axion Engine & Ax Kernel Manager (MediaTek adaptation)
allow system_server sysfs_devices_system_cpu:file rw_file_perms;
allow system_server cgroup:file rw_file_perms;

allow system_server sysfs_devfreq:dir search;
allow system_server sysfs_devfreq:file rw_file_perms;

allow system_server sysfs_ged_tuning:dir search;
allow system_server sysfs_ged_tuning:file rw_file_perms;

allow system_server proc_gpufreq:dir search;
allow system_server proc_gpufreq:file rw_file_perms;

allow system_server proc_sched:file rw_file_perms;
allow system_server proc_drop_caches:file rw_file_perms;
allow system_server proc_dirty:file rw_file_perms;
