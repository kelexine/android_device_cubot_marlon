<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Configure wifi tcp buffersizes in the form:
         rmem_min,rmem_def,rmem_max,wmem_min,wmem_def,wmem_max -->
    <string name="config_wifi_tcp_buffers" translatable="false">524288,1048576,4194304,262144,524288,3670016</string>

    <!-- Boolean indicating whether the Wi-Fi chipset supports dual band (2.4GHz and 5GHz) -->
    <bool translatable="false" name="config_wifi_dual_band_support">true</bool>

    <!-- Boolean indicating whether 5GHz band is supported for SoftAP -->
    <bool translatable="false" name="config_wifi_softap_5ghz_supported">true</bool>

    <!-- Boolean indicating whether IEEE80211AC is supported for SoftAP -->
    <bool translatable="false" name="config_wifi_softap_ieee80211ac_supported">true</bool>

    <!-- Boolean indicating whether Wi-Fi P2P (Wi-Fi Direct) MAC randomization is supported -->
    <bool translatable="false" name="config_wifi_p2p_mac_randomization_supported">true</bool>

    <!-- Channel list for 5GHz SoftAP operation -->
    <string translatable="false" name="config_wifi_framework_sap_2G_channel_list">1,6,11</string>

</resources>
