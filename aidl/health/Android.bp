cc_binary {
    name: "android.hardware.health-service.marlon",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.health-service.marlon.rc"],
    vintf_fragments: ["android.hardware.health-service.marlon.xml"],
    defaults: [
        "libhealth_aidl_charger_defaults",
    ],
    static_libs: [
        "libhealth_aidl_impl",
    ],
    srcs: [
        "Health.cpp",
        "main.cpp",
    ],
    overrides: [
        "charger",
    ],
}
