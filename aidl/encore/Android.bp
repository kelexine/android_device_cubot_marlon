// Purpose: Soong build definition for vendor.cubot.hardware.encore AIDL interface.
//

aidl_interface {
    name: "vendor.cubot.hardware.encore",
    owner: "cubot",
    vendor_available: true,
    srcs: [
        "vendor/cubot/hardware/encore/*.aidl",
    ],
    unstable: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
    },
}
