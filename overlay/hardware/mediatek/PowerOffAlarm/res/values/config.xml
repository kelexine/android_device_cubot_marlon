<resources>

    <!--
        List of enabled PowerOffAlarm drivers, initialization is attempted in this order.

        - alarm: /dev/alarm legacy driver with MTK modifications (preferred for MT6765 stock LK)
        - rtc: MTK modern userspace ioctl
        - timerfd: exists, but sets logo flag in MTK kernel which disrupts stock LK ALARM_BOOT
    -->
    <string name="config_powerOffAlarmDrivers" translatable="false">alarm,rtc,timerfd</string>
</resources>
