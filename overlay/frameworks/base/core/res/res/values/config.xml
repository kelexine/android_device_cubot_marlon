<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Screen brightness settings (stock Cubot P50 framework-res) -->
    <integer name="config_screenBrightnessSettingMinimum">10</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">102</integer>
    <integer name="config_screenBrightnessDim">10</integer>
    <integer name="config_screenBrightnessDark">1</integer>
    <integer name="config_screenBrightnessDoze">1</integer>

    <!-- Float brightness equivalents (for modern Android DisplayPowerController) -->
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.05</item>
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.0</item>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.039215686</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.4</item>

    <!-- Whether the display blanks itself when transitioning from a doze to a non-doze state -->
    <bool name="config_displayBlanksAfterDoze">true</bool>

    <!-- If true, the doze component is not started until after the screen has been
         turned off and the screen off animation has been performed. -->
    <bool name="config_dozeAfterScreenOffByDefault">false</bool>

    <!-- Doze / Ambient Display: Cubot P50 is an LCD panel, not OLED. Disable AOD/Doze on screen off. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- Power Management: Specifies whether to decouple the auto-suspend state of the
         device from the display on/off state. -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>

    <!-- Whether the device supports double tap to wake -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Automatic brightness available -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Stability requirements in milliseconds for accepting a new brightness level
         immediately, in the case where the new lux reading is greater or less than current lux. -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">4000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">8000</integer>

    <!-- Array of hysteresis constraint values for brightening, represented as tenths of a percent. -->
    <integer-array name="config_ambientBrighteningThresholds">
        <item>100</item>
    </integer-array>

    <!-- Array of hysteresis constraint values for darkening, represented as tenths of a percent. -->
    <integer-array name="config_ambientDarkeningThresholds">
        <item>200</item>
    </integer-array>

    <!-- Array of light sensor lux values to define levels for auto backlight brightness support
         (stock Cubot P50 FrameworkResOverlay). -->
    <integer-array name="config_autoBrightnessLevels">
        <item>128</item>
        <item>256</item>
        <item>384</item>
        <item>512</item>
        <item>640</item>
        <item>768</item>
        <item>896</item>
        <item>1024</item>
        <item>2048</item>
        <item>4096</item>
        <item>6144</item>
        <item>8192</item>
        <item>10240</item>
        <item>12288</item>
        <item>14336</item>
        <item>16384</item>
        <item>18432</item>
    </integer-array>

    <!-- Array of desired screen brightness in range 0-255 corresponding to config_autoBrightnessLevels
         (stock Cubot P50 FrameworkResOverlay, size = size(config_autoBrightnessLevels) + 1 = 18). -->
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>8</item>
        <item>64</item>
        <item>98</item>
        <item>104</item>
        <item>110</item>
        <item>116</item>
        <item>122</item>
        <item>128</item>
        <item>134</item>
        <item>182</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- When true use the linux /dev/input/event subsystem to detect the switch changes
         on the headphone/microphone jack. When false use the older uevent framework. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Notification & Battery LED (Physical LED is Blue) -->
    <bool name="config_intrusiveNotificationLed">true</bool>
    <color name="config_defaultNotificationColor">#ff0000ff</color>
    <integer name="config_defaultNotificationLedOn">500</integer>
    <integer name="config_defaultNotificationLedOff">2000</integer>
    <integer name="config_notificationsBatteryLowARGB">0xff0000ff</integer>
    <integer name="config_notificationsBatteryMediumARGB">0xff0000ff</integer>
    <integer name="config_notificationsBatteryFullARGB">0xff0000ff</integer>
    <integer name="config_notificationsBatteryLedOn">125</integer>
    <integer name="config_notificationsBatteryLedOff">2875</integer>

    <!-- Boolean indicating whether the HWC setColorTransform function can be performed efficiently in hardware. -->
    <bool name="config_setColorTransformAccelerated">true</bool>

    <!-- Proximity check on wake -->
    <bool name="config_proximityCheckOnWake">true</bool>
    <bool name="config_proximityCheckOnWakeEnabledByDefault">true</bool>

    <!-- Flag indicating whether the surface flinger has limited alpha compositing functionality in hardware. -->
    <bool name="config_sf_limitedAlpha">true</bool>

    <!-- Enable ZRAM writeback to swap out idle compressed pages to backing storage -->
    <bool name="config_zramWriteback">true</bool>

    <!-- Disable high performance window transitions on mid-tier SoC -->
    <bool name="config_deviceSupportsHighPerfTransitions">false</bool>

    <!-- Run shell features off the main thread -->
    <bool name="config_enableShellMainThread">true</bool>

    <!-- Framework SQLite acceleration -->
    <string name="db_default_journal_mode">MEMORY</string>
    <string name="db_default_sync_mode">OFF</string>
    <string name="db_wal_sync_mode">OFF</string>

</resources>
